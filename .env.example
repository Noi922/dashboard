# ---------- TrueNAS (Pflicht) ----------
# IP-Adresse oder Hostname deines TrueNAS, ohne https://
TRUENAS_HOST=192.168.1.10
# API-Key aus der TrueNAS-Oberfläche (siehe README)
TRUENAS_API_KEY=
# Nur auf true setzen, wenn TrueNAS ein gültiges (nicht selbstsigniertes) Zertifikat hat
TRUENAS_VERIFY_TLS=false
# Apps und VMs im Dashboard starten/stoppen erlauben
ENABLE_ACTIONS=false

# ---------- Dashboard ----------
# Passwort für das Dashboard (Benutzername beliebig). Dringend empfohlen, sobald E-Mails angezeigt werden.
DASHBOARD_PASSWORD=
TZ=Europe/Berlin

# ---------- E-Mail (optional, nur lesend über IMAP) ----------
# Beispiele: imap.web.de, imap.gmx.net, imap.gmail.com (dort ein App-Passwort verwenden)
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# ---------- Kalender (optional) ----------
# Private ICS-/iCal-Links, mit Komma getrennt. Optional mit Namen: Name|Link
# CALENDAR_URLS=Privat|https://example.org/privat.ics,Arbeit|https://example.org/arbeit.ics
CALENDAR_URLS=

# ---------- Nachrichten (optional) ----------
# RSS-Feeds, mit Komma getrennt
NEWS_FEEDS=https://www.tagesschau.de/index~rss2.xml

# ---------- Wetter (optional, Open-Meteo, kein Konto nötig) ----------
# Koordinaten deines Ortes, z. B. Berlin: 52.52 / 13.41
WEATHER_LAT=
WEATHER_LON=
WEATHER_NAME=
